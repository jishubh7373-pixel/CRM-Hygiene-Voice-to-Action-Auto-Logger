# ==============================================================================
# DealFlow AI — Production Environment Template
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Generate high-entropy cryptographically random strings for all secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.dealflow.ai

# MongoDB Production Connection (MongoDB Atlas / Managed Cluster with replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dealflow_ai_prod?retryWrites=true&w=majority&maxPoolSize=50

# Redis Production Connection (Managed Redis Cluster / Redis Cloud / AWS ElastiCache)
REDIS_HOST=redis.internal.dealflow.ai
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_CRYPTOGRAPHIC_PASSWORD_HERE
# REDIS_URL=rediss://default:PASSWORD@redis.internal.dealflow.ai:6379

# Cryptographic Tokens (Must be distinct 64-character hex strings)
JWT_ACCESS_SECRET=GENERATE_64_CHAR_HEX_KEY_FOR_ACCESS_TOKENS
JWT_REFRESH_SECRET=GENERATE_64_CHAR_HEX_KEY_FOR_REFRESH_TOKENS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Integration Credential Vault (32-byte AES-256-GCM encryption key)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_VAULT_KEY

# OpenAI Production API Configuration
OPENAI_API_KEY=sk-proj-YOUR_ACTUAL_PRODUCTION_OPENAI_API_KEY
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Object Storage Configuration (S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=s3
MAX_AUDIO_UPLOAD_MB=50
S3_BUCKET_NAME=dealflow-audio-recordings-prod
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=YOUR_AWS_OR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_AWS_OR_R2_SECRET_ACCESS_KEY
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Zoom Integration (Production OAuth App & Webhook Verification)
ZOOM_CLIENT_ID=YOUR_PRODUCTION_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=YOUR_PRODUCTION_ZOOM_CLIENT_SECRET
ZOOM_WEBHOOK_SECRET=YOUR_PRODUCTION_ZOOM_WEBHOOK_SECRET_TOKEN
ZOOM_REDIRECT_URI=https://api.dealflow.ai/api/v1/integrations/zoom/callback

# Gong Integration (API v2)
GONG_ACCESS_KEY=YOUR_PRODUCTION_GONG_ACCESS_KEY
GONG_CLIENT_SECRET=YOUR_PRODUCTION_GONG_CLIENT_SECRET
GONG_BASE_URL=https://api.gong.io

# HubSpot CRM Integration (OAuth 2.0 App)
HUBSPOT_CLIENT_ID=YOUR_PRODUCTION_HUBSPOT_CLIENT_ID
HUBSPOT_CLIENT_SECRET=YOUR_PRODUCTION_HUBSPOT_CLIENT_SECRET
HUBSPOT_REDIRECT_URI=https://api.dealflow.ai/api/v1/integrations/hubspot/callback
HUBSPOT_SCOPES=crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read crm.schemas.deals.read

# Jira Cloud Integration (Atlassian 3LO OAuth App)
JIRA_CLIENT_ID=YOUR_PRODUCTION_ATLASSIAN_CLIENT_ID
JIRA_CLIENT_SECRET=YOUR_PRODUCTION_ATLASSIAN_CLIENT_SECRET
JIRA_REDIRECT_URI=https://api.dealflow.ai/api/v1/integrations/jira/callback
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access
