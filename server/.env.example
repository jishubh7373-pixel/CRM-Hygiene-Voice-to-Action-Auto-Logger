# DealFlow AI Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/dealflow_ai

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Audio Storage Configuration
STORAGE_PROVIDER=local
MAX_AUDIO_UPLOAD_MB=25
# LOCAL_STORAGE_PATH=
# S3_BUCKET_NAME=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Integrations Credential Encryption (AES-256-GCM 32-byte secret)
INTEGRATION_ENCRYPTION_KEY=your_32_byte_hex_or_passphrase_for_aes_256_gcm

# Zoom Integration (OAuth & RTMS)
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret_token
ZOOM_REDIRECT_URI=http://localhost:5000/api/v1/integrations/zoom/callback

# Gong Integration (API v2)
GONG_ACCESS_KEY=your_gong_access_key
GONG_CLIENT_SECRET=your_gong_client_secret
GONG_BASE_URL=https://api.gong.io

# HubSpot CRM Integration (OAuth 2.0)
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret
HUBSPOT_REDIRECT_URI=http://localhost:5000/api/v1/integrations/hubspot/callback
HUBSPOT_SCOPES=crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read crm.schemas.deals.read

# Jira Cloud Integration (Atlassian OAuth 2.0 3LO)
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_REDIRECT_URI=http://localhost:5000/api/v1/integrations/jira/callback
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access


